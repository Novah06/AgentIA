# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
# Pas d'inscription publique : les comptes clients sont créés en interne
# (voir docs/creation-comptes-clients.md)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/studio

# Anthropic
ANTHROPIC_API_KEY=sk-ant-xxx

# Supabase
# La cle anon n'est pas utilisee : tout passe par le serveur.
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJxxx

# Resend (email)
RESEND_API_KEY=re_xxx
CONTACT_EMAIL=contact@synapse-ai.fr

# --- Portefeuille Pokémon ---
# Secret attendu par les routes des bots (/api/tcg/cron/*, /api/tcg/prix/import).
# Vercel Cron l'envoie automatiquement s'il est défini dans le projet.
CRON_SECRET=changez-moi
# Adresse de l'application, utilisée par scripts/tcg-bot.mjs
TCG_APP_URL=http://localhost:3000
# Clé pokemontcg.io (facultative) : sans clé, 1 000 requêtes par jour suffisent
# à relever un portefeuille de taille normale.
POKEMONTCG_API_KEY=
